import java.util.Scanner;
import java.util.Stack;
import java.util.Queue;
import java.util.LinkedList;

public class PalindromeChecker {
    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter a word: ");
        String text = scanner.nextLine();

        String cleaned = text.replaceAll("[^a-zA-Z0-9]", "").toLowerCase();

        String reversed = "";
        for (int i = cleaned.length() - 1; i >= 0; i--) {
            reversed += cleaned.charAt(i);
        }

        if (cleaned.equals(reversed)) {
            System.out.println("It is a Palindrome.");
        } else {
            System.out.println("It is not a Palindrome.");
        }

        // -------- UC6: Queue + Stack Palindrome Check --------

        Stack<Character> stack = new Stack<>();
        Queue<Character> queue = new LinkedList<>();

        // Push to stack and enqueue to queue
        for (int i = 0; i < cleaned.length(); i++) {
            stack.push(cleaned.charAt(i));      // LIFO
            queue.add(cleaned.charAt(i));       // FIFO
        }

        boolean isPalindrome = true;

        // Compare pop from stack and dequeue from queue
        while (!stack.isEmpty() && !queue.isEmpty()) {
            if (stack.pop() != queue.remove()) {
                isPalindrome = false;
                break;
            }
        }

        if (isPalindrome) {
            System.out.println("It is a Palindrome (using Queue + Stack).");
        } else {
            System.out.println("It is not a Palindrome (using Queue + Stack).");
        }

        scanner.close();
    }
}